# WebVault - Environment Configuration
# Copy this file to .env

# After starting the app, generate keys:
#   docker exec webvault-garage /garage key create webvault-app
#   docker exec webvault-garage /garage bucket allow --read --write --owner archives --key <KEY_ID>

# Then add your keys here:
# GARAGE_ACCESS_KEY=GK...
# GARAGE_SECRET_KEY=1a2b...

# Optional:
# GARAGE_BUCKET=archives