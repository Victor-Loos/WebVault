# WebVault - Environment Configuration
# Copy this file to .env

# After starting the app, generate keys:
#   docker exec webvault-garage /garage key create webvault-app
#   docker exec webvault-garage /garage bucket allow --read --write --owner archives --key <KEY_ID>

# Then add your keys here:
# GARAGE_ACCESS_KEY=GK...
# GARAGE_SECRET_KEY=1a2b...

# Optional:
# GARAGE_BUCKET=archives

# Garage layout capacity for new and existing single-node installations.
# Run ./garage/resize.sh after changing it.
# GARAGE_CAPACITY=100G

# setup.sh generates these credentials because authentication is enabled by default.
# A partial credential configuration is rejected.
# WEBVAULT_USERNAME=admin
# WEBVAULT_PASSWORD=use-a-long-random-password

# Explicit loopback-only escape hatch for deployments that accept the risk.
# WEBVAULT_ALLOW_UNAUTHENTICATED=false

# The UI binds to loopback by default. Non-loopback binding requires authentication.
# WEBVAULT_BIND_ADDRESS=0.0.0.0

# Host headers accepted by the application (comma-separated). Add your reverse
# proxy's public hostname before exposing WebVault through it.
# WEBVAULT_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],vault.example.com

# Bound the SQLite queue to protect a single-server deployment.
# MAX_QUEUED_JOBS=100

# Private, loopback, and link-local crawl targets are blocked by default.
# ALLOW_PRIVATE_CRAWLS=false

# WebVault defaults to the tested 1.14.0 release. Change only after validating
# existing browser login profiles against the new crawler version.
# BROWSERTRIX_IMAGE=docker.io/webrecorder/browsertrix-crawler:1.14.0

# Internal Browsertrix live-view port.
# SCREENCAST_PORT=9037

# Optional SQLite location. Compose persists this in the webvault_state volume.
# WEBVAULT_DB_PATH=/data/webvault.db